<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_all" />

        <Switch
            android:id="@+id/switchSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_sms" />

        <Switch
            android:id="@+id/switchNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_notif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reply_label"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/editReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delay_label"
            android:paddingTop="10dp" />

        <EditText
            android:id="@+id/editDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Switch
            android:id="@+id/switchRandomDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_delay" />

        <EditText
            android:id="@+id/editMaxDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/max_delay_label"
            android:inputType="number" />

        <Button
            android:id="@+id/btnPickApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_apps" />

        <TextView
            android:id="@+id/textSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FF4444FF" />

        <Button
            android:id="@+id/btnAppRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_rules" />

        <Button
            android:id="@+id/btnSmartRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smart_rules" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/method_label"
            android:paddingTop="10dp" />

        <Spinner
            android:id="@+id/spinnerMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/methods" />

        <Switch
            android:id="@+id/switchQuiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quiet_enable"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quiet_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editQuietStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="22:00"
                android:inputType="time" />

            <EditText
                android:id="@+id/editQuietEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="07:00"
                android:inputType="time" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchScreenOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_off" />

        <Switch
            android:id="@+id/switchDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dnd" />

        <Switch
            android:id="@+id/switchSkipContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skip_contacts" />

        <Button
            android:id="@+id/btnContactsPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_perm" />

        <Switch
            android:id="@+id/switchDryRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dry_run" />

        <Switch
            android:id="@+id/switchNotifyOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notify_on" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/max_per_day"
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/editMaxPerDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cooldown_label"
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/editCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Switch
            android:id="@+id/switchOnlyNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/only_numbers_enable" />

        <EditText
            android:id="@+id/editOnlyNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/only_numbers_label"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <EditText
            android:id="@+id/editIgnoredNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ignored_label"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <Button
            android:id="@+id/btnSmsPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sms_permission" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_access" />

        <Button
            android:id="@+id/btnNotifPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_permission" />

        <Button
            android:id="@+id/btnA11yPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/a11y_permission" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_number_label"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/editTestNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:hint="+8801XXXXXXXXX" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_button" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_button" />

        <Button
            android:id="@+id/btnShareLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_log" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
